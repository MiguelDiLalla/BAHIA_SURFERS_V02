# Environment Variables Template
# Copy this file to .env for local development

# Vite Public Variables (accessible in client code)
# Prefix with VITE_ to make them available via import.meta.env

# Example: API endpoints
# VITE_API_URL=https://api.example.com
# VITE_STREAM_URL=https://stream.example.com

# Example: Feature flags
# VITE_ENABLE_PWA=true
# VITE_ENABLE_ANALYTICS=false

# Example: App metadata
# VITE_APP_NAME="Bahia Surfers Radio"
# VITE_APP_VERSION=1.0.0
